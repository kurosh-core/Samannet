# کپی این فایل را به نام .env بسازید و مقادیر را تغییر دهید
DATABASE_URL=postgresql://ccp:ccp_password@localhost:5432/config_cloud_panel?schema=public

# حداقل 32 کاراکتر تصادفی - برای امضای Session/JWT
SESSION_SECRET=change_this_to_a_long_random_string_min_32_chars

# دقیقا 32 بایت (Base64) - برای رمزنگاری Secretها (AES-256-GCM)
# می‌توانید با دستور زیر بسازید: openssl rand -base64 32
ENCRYPTION_KEY=change_this_to_a_base64_32_byte_key_xxxxxxxxx=

# اختیاری - در صورت استفاده از Cloudflare OAuth (در صورت نبود، حالت API Token فعال می‌شود)
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
